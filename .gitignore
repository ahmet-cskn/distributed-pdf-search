# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environment (managed by uv)
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment files and secrets
.env
.env.*

# Terraform (state can contain sensitive values)
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# Variable files hold personal values (e.g. the budget alert email)
*.tfvars
!*.tfvars.example
# Saved plans can contain sensitive values too
*.tfplan

# Generated Kubernetes settings (see k8s/aws.env.example)
k8s/aws.env

# Folder watched by pdfsearch-watch: PDFs must never be committed
/inbox/

# Editors and OS
.vscode/
.idea/
.DS_Store
